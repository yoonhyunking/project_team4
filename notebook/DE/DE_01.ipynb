"""
 
import json
from pathlib import Path
 
import numpy as np
import torch
from PIL import Image
from torch.utils.data import DataLoader, Dataset
 
import albumentations as A
from albumentations.pytorch import ToTensorV2
 
 
# ─────────────────────────────────────────────────────────────
# 설정 (TODO: 데이터 확인 후 채우기)
# ─────────────────────────────────────────────────────────────
IMG_SIZE = 512
NUM_CLASSES = 73          # TODO: 배경 포함 클래스 수 (예: 알약 72종 + 배경 1 = 73)
NORMALIZE_MEAN = [0.485, 0.456, 0.406]   # ImageNet pretrained 기준
NORMALIZE_STD = [0.229, 0.224, 0.225]
 
 
# ─────────────────────────────────────────────────────────────
# Dataset
# ─────────────────────────────────────────────────────────────
class PillDetectionDataset(Dataset):
    """
    반환 형식
    --------
    mode='train' / 'val':
        image  : Tensor [3, H, W]  (normalize 완료)
        target : dict
            - boxes    : Tensor [N, 4]  (x1, y1, x2, y2)  pascal_voc 형식
            - labels   : Tensor [N]     (int64)
            - image_id : Tensor [1]
 
    mode='test' (어노테이션 없음):
        image    : Tensor [3, H, W]
        image_id : str  (파일명 stem, 제출 파일에 쓰기 좋음)
    """
 
    def __init__(self, image_dir, annotation_dir=None, transform=None, mode="train"):
        self.image_dir = Path(image_dir)
        self.annotation_dir = Path(annotation_dir) if annotation_dir else None
        self.transform = transform
        self.mode = mode
 
        # 이미지 파일 목록 정렬해서 보관
        self.image_files = sorted(
            [p for p in self.image_dir.iterdir()
             if p.suffix.lower() in (".png", ".jpg", ".jpeg")]
        )
 
        if len(self.image_files) == 0:
            raise FileNotFoundError(f"이미지가 없습니다: {self.image_dir}")
 
    def __len__(self):
        return len(self.image_files)
 
    def __getitem__(self, idx):
        img_path = self.image_files[idx]
        image = np.array(Image.open(img_path).convert("RGB"))
 
        # ── test: 어노테이션 없이 추론용 ──────────────────────
        if self.mode == "test":
            if self.transform:
                image = self.transform(image=image)["image"]
            return image, img_path.stem
 
        # ── train / val: 어노테이션 함께 로드 ─────────────────
        boxes, labels = self._load_annotation(img_path.stem)
 
        if self.transform:
            out = self.transform(image=image, bboxes=boxes, labels=labels)
            image = out["image"]
            boxes = out["bboxes"]
            labels = out["labels"]
 
        # 박스가 augmentation으로 모두 잘려나간 경우 방어
        if len(boxes) == 0:
            boxes_tensor = torch.zeros((0, 4), dtype=torch.float32)
            labels_tensor = torch.zeros((0,), dtype=torch.int64)
        else:
            boxes_tensor = torch.as_tensor(boxes, dtype=torch.float32)
            labels_tensor = torch.as_tensor(labels, dtype=torch.int64)
 
        target = {
            "boxes": boxes_tensor,
            "labels": labels_tensor,
            "image_id": torch.tensor([idx]),
        }
        return image, target
 
    def _load_annotation(self, stem):
        """이미지 stem과 같은 이름의 .json 로드"""
        ann_path = self.annotation_dir / f"{stem}.json"
        with open(ann_path, "r", encoding="utf-8") as f:
            ann = json.load(f)
        return self._parse_annotation(ann)
 
    @staticmethod
    def _parse_annotation(ann):
        """
        TODO: 실제 JSON 구조에 맞춰 수정.
        아래는 COCO 스타일을 가정한 예시.
 
        예) {
              "annotations": [
                  {"bbox": [x, y, w, h], "category_id": 1},
                  ...
              ]
            }
        반환: boxes (List[[x1,y1,x2,y2]]), labels (List[int])
        """
        boxes, labels = [], []
        for obj in ann.get("annotations", []):
            x, y, w, h = obj["bbox"]                  # COCO 포맷: [x, y, w, h]
            boxes.append([x, y, x + w, y + h])        # pascal_voc 포맷으로 변환
            labels.append(int(obj["category_id"]))
        return boxes, labels
 
 
# ─────────────────────────────────────────────────────────────
# Transforms (bbox-aware augmentation)
# ─────────────────────────────────────────────────────────────
def _bbox_params():
    return A.BboxParams(
        format="pascal_voc",
        label_fields=["labels"],
        min_visibility=0.3,   # 증강 후 30% 이상 남은 박스만 유지
    )
 
 
def get_train_transform():
    return A.Compose(
        [
            A.Resize(IMG_SIZE, IMG_SIZE),
            A.HorizontalFlip(p=0.5),
            A.RandomBrightnessContrast(p=0.3),
            A.HueSaturationValue(hue_shift_limit=10, sat_shift_limit=20,
                                 val_shift_limit=10, p=0.3),
            A.Affine(scale=(0.9, 1.1), translate_percent=(0, 0.05),
                     rotate=(-10, 10), p=0.3),
            A.Normalize(mean=NORMALIZE_MEAN, std=NORMALIZE_STD),
            ToTensorV2(),
        ],
        bbox_params=_bbox_params(),
    )
 
 
def get_val_transform():
    return A.Compose(
        [
            A.Resize(IMG_SIZE, IMG_SIZE),
            A.Normalize(mean=NORMALIZE_MEAN, std=NORMALIZE_STD),
            ToTensorV2(),
        ],
        bbox_params=_bbox_params(),
    )
 
 
def get_test_transform():
    # 테스트는 박스 없음 → bbox_params 불필요
    return A.Compose(
        [
            A.Resize(IMG_SIZE, IMG_SIZE),
            A.Normalize(mean=NORMALIZE_MEAN, std=NORMALIZE_STD),
            ToTensorV2(),
        ]
    )
 
 
# ─────────────────────────────────────────────────────────────
# DataLoader
# ─────────────────────────────────────────────────────────────
def collate_fn(batch):
    """
    객체 검출에서는 이미지마다 박스 개수가 달라서 default_collate 불가.
    이미지 리스트, 타겟 리스트 그대로 반환하는 형태(torchvision 표준)로 묶음.
    """
    return tuple(zip(*batch))
 
 
def _split_indices(n, val_ratio, seed=42):
    """train 폴더 안의 데이터를 train / val 로 분리할 인덱스 생성"""
    rng = np.random.default_rng(seed)
    indices = np.arange(n)
    rng.shuffle(indices)
    val_size = int(n * val_ratio)
    return indices[val_size:].tolist(), indices[:val_size].tolist()
 
 
def get_loader(DATA_PATH, BATCH_SIZE, val_ratio=0.2, num_workers=4, seed=42):
    """
    Parameters
    ----------
    DATA_PATH    : str | Path  데이터 루트 (예: "data/sprint_ai_project1_data")
    BATCH_SIZE   : int
    val_ratio    : float       train 중 val 로 떼어낼 비율 (기본 0.2)
    num_workers  : int
    seed         : int         train/val split 고정용
 
    Returns
    -------
    train_loader, val_loader, test_loader
    """
    DATA_PATH = Path(DATA_PATH)
    train_img_dir = DATA_PATH / "train_images"
    train_ann_dir = DATA_PATH / "train_annotation"
    test_img_dir = DATA_PATH / "test_images"
 
    # train / val 은 같은 폴더에서 split — transform을 따로 주려고
    # 두 개의 인스턴스를 만든 뒤 파일 리스트만 갈아끼움
    train_dataset = PillDetectionDataset(
        image_dir=train_img_dir,
        annotation_dir=train_ann_dir,
        transform=get_train_transform(),
        mode="train",
    )
    val_dataset = PillDetectionDataset(
        image_dir=train_img_dir,
        annotation_dir=train_ann_dir,
        transform=get_val_transform(),
        mode="train",
    )
 
    n_total = len(train_dataset)
    train_idx, val_idx = _split_indices(n_total, val_ratio, seed=seed)
    train_dataset.image_files = [train_dataset.image_files[i] for i in train_idx]
    val_dataset.image_files = [val_dataset.image_files[i] for i in val_idx]
 
    test_dataset = PillDetectionDataset(
        image_dir=test_img_dir,
        annotation_dir=None,
        transform=get_test_transform(),
        mode="test",
    )
 
    train_loader = DataLoader(
        train_dataset, batch_size=BATCH_SIZE, shuffle=True,
        num_workers=num_workers, collate_fn=collate_fn, pin_memory=True,
    )
    val_loader = DataLoader(
        val_dataset, batch_size=BATCH_SIZE, shuffle=False,
        num_workers=num_workers, collate_fn=collate_fn, pin_memory=True,
    )
    test_loader = DataLoader(
        test_dataset, batch_size=BATCH_SIZE, shuffle=False,
        num_workers=num_workers, pin_memory=True,
    )
 
    return train_loader, val_loader, test_loader
 
 
# ─────────────────────────────────────────────────────────────
# 동작 확인용 — 직접 실행해서 형식 점검
# ─────────────────────────────────────────────────────────────
if __name__ == "__main__":
    train_loader, val_loader, test_loader = get_loader(
        DATA_PATH="data/sprint_ai_project1_data",
        BATCH_SIZE=4,
        num_workers=0,   # 디버깅 시에는 0이 편함
    )
 
    print(f"[크기] train={len(train_loader.dataset)} "
          f"val={len(val_loader.dataset)} test={len(test_loader.dataset)}")
 
    images, targets = next(iter(train_loader))
    print(f"[train batch] images={len(images)}, image[0].shape={images[0].shape}")
    print(f"[train batch] target[0]={ {k: v.shape for k, v in targets[0].items()} }")
 
    images, ids = next(iter(test_loader))
    print(f"[test batch] images={len(images)}, ids[:3]={list(ids)[:3]}")
